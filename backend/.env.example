# Application
APP_NAME=Construction AI API
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Database
# Staging / production — Neon PostgreSQL (connection string from neon.tech):
#   DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Offline local development — a SQLite file (no external DB needed):
#   DATABASE_URL=sqlite:///./structura_dev.db
DATABASE_URL=YOUR_NEON_CONNECTION_STRING

# Security — generate a strong secret for production
SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default admin (auto-seeded on first startup if no ADMIN exists)
# Email: admin@constructionai.com | Password: admin123

# --- Pre-Construction Feasibility Analyzer (R26_IT_154) ---------------------
# Google Earth Engine service account key (path relative to backend/).
# Absent  -> land analyzer uses deterministic synthetic terrain (still works).
GEE_KEY_PATH=gee-key.json
GEE_PROJECT=landanalyzeraiproject

# YOLOv8 land-boundary segmentation weights (path relative to backend/).
YOLO_SEG_WEIGHTS_PATH=weights/land_segmentation.pt
YOLO_SEG_FALLBACK=yolov8n-seg.pt

# Optional: absolute path to the Tesseract OCR binary for Module 2.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=

# External services (defaults are fine for local dev)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT=R26-IT-154-feasibility-analyzer/1.0 (undergraduate research project)
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
