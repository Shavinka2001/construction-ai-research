# Application
APP_NAME=Construction AI API
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Database — Neon PostgreSQL (replace with your connection string from neon.tech)
# Example format:
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=YOUR_NEON_CONNECTION_STRING

# Security — generate a strong secret for production
SECRET_KEY=change-me-in-production-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Default admin (auto-seeded on first startup if no ADMIN exists)
# Email: admin@constructionai.com | Password: admin123
