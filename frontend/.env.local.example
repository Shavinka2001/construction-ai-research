# ---------------------------------------------------------------------------
# Frontend environment
#
# Local development: copy this file to `.env.local` and start the backend on
# the port below.
#
# Vercel: set NEXT_PUBLIC_API_URL in Project Settings -> Environment Variables.
# It is read at BUILD time (NEXT_PUBLIC_* is inlined into the bundle), so after
# changing it you must redeploy — editing the variable alone does nothing to an
# existing deployment.
#
# If it is left unset, the value below is baked in. On a deployed site that
# means every API call points at the VISITOR's own machine and fails. The seven
# public tabs (Home, Domain, Milestones, Documents, Presentations, About us,
# Contact us) are unaffected because they make no API calls — only /login,
# /register and /dashboard need this.
# ---------------------------------------------------------------------------

# Backend API (used by the Next.js client and server-side routes)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001

# Optional override for the compliance proxy (defaults to NEXT_PUBLIC_API_URL)
# COMPLIANCE_SERVICE_URL=http://127.0.0.1:8001
